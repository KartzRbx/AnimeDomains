            <Item class="ModuleScript" referent="202">
              <Properties>
                <string name="Name">Stroke</string>
                <string name="Source">local RunService = game:GetService("RunService");
local SmartAssert = require(script.Parent.Util);

-- Fingeroo was here ( ͡° ͜ʖ ͡°)

export type Stroke&lt;T...> = {
	UIInstance: GuiObject,
	Instance: UIStroke,
	IsPaused: boolean,
	UseScaledSize: boolean,
	Color: Color3,
	ColorTarget: Color3,
	ColorAcceleration: number,
	Transparency: number,
	TransparencyTarget: number,
	TransparencyAcceleration: number,
	Size: number,
	SizeTarget: number,
	SizeAcceleration: number,
	Connection: RBXScriptConnection,
	IsText: boolean,

	Pause: (self: Stroke&lt;T...>) -> nil,
	Resume: (self: Stroke&lt;T...>) -> nil,
	SetSize: (self: Stroke&lt;T...>, size: number, acceleration: number) -> nil,
	SetTransparency: (self: Stroke&lt;T...>, transparency: number, acceleration: number) -> nil,
	SetColor: (self: Stroke&lt;T...>, color: Color3, acceleration: number) -> nil,
	SetScaledSize: (self: Stroke&lt;T...>, useScaledSize: boolean) -> nil,
	Destroy: (self: Stroke&lt;T...>) -> nil,
};

local Stroke = {};
Stroke.__index = Stroke;

function Stroke.new&lt;T...>(uiInstance: GuiObject | UIStroke, size: number, color: Color3?, transparency: number?, useScaledSize: boolean?): Stroke&lt;T...>
	SmartAssert(uiInstance ~= nil, "UIInstance not provided");
	SmartAssert(uiInstance:IsA("GuiObject") or uiInstance:IsA("UIStroke"), "UIInstance is not a GuiObject or UIStroke");
	SmartAssert(size ~= nil, "Size not provided");
	SmartAssert(typeof(size) == "number", "Size is not a number");
	if (color) then
		SmartAssert(typeof(color) == "Color3", "Color is not a Color3");
	end;
	if (transparency) then
		SmartAssert(typeof(transparency) == "number", "Transparency is not a number");
	end;
	if (useScaledSize ~= nil) then
		SmartAssert(typeof(useScaledSize) == "boolean", "useScaledSize is not a boolean");
	end;

	local self = {};

	self.UIInstance = uiInstance;
	self.Instance = uiInstance:FindFirstChildWhichIsA("UIStroke") or Instance.new("UIStroke");
	self.UseScaledSize = useScaledSize == true;
	if (useScaledSize == true) then
		self.Instance.StrokeSizingMode = Enum.StrokeSizingMode.ScaledSize;
	end;
	self.IsPaused = false;

	self.Color = color or Color3.new(1, 1, 1);
	self.ColorTarget = color or Color3.new(1, 1, 1);
	self.ColorAcceleration = 1;

	self.Transparency = transparency or 0;
	self.TransparencyTarget = transparency or 0;
	self.TransparencyAcceleration = 1;

	if self.UseScaledSize and math.abs(size) > 1 then
		size = size / 100;
	end

	self.Size = size;
	self.SizeTarget = size;
	self.SizeAcceleration = 1;
	self.Connection = nil;
	self.IsText = false;

	if (uiInstance:IsA("TextLabel") or uiInstance:IsA("TextBox") or uiInstance:IsA("TextButton")) then
		self.IsText = true;
	end;

	self.Instance.Parent = self.UIInstance;

	self.Connection = RunService.Heartbeat:Connect(function(dt)
		if (self.IsPaused) then
			return;
		end;

		if (not self.UIInstance or self.UIInstance.Parent == nil) then
			self:Destroy();
			return;
		end;

		self.Color = self.Color:Lerp(self.ColorTarget, self.ColorAcceleration * dt * 10);
		self.Size = self.Size + ((self.SizeTarget - self.Size) * self.SizeAcceleration * dt * 10);
		self.Transparency = self.Transparency + ((self.TransparencyTarget - self.Transparency) * self.TransparencyAcceleration * dt * 10);

		self.Instance.Transparency = self.Transparency;
		self.Instance.Color = self.Color;
		self.Instance.Thickness = self.Size;
	end);

	return setmetatable(self, Stroke);
end

function Stroke:SetSize(size: number, acceleration: number)
	-- Accepts a number as the first argument and a number as the second argument.
	-- Values below 0 or above 1 for the acceleration argument do not make sense.
	SmartAssert(typeof(size) == "number", "Size isn't a number");
	SmartAssert(typeof(acceleration) == "number", "Acceleration isn't a number");

	-- What I thought of doing here is when someone uses ScaledSize and they pass a number greater than 1, we divide it by 100 to get the percentage.
	if self.UseScaledSize and math.abs(size) > 1 then
		size = size / 100;
	end

	self.SizeTarget = size;
	self.SizeAcceleration = math.clamp(acceleration, 0, 1);
end

function Stroke:SetTransparency(transparency: number, acceleration: number)
	-- Accepts a number as the first argument and a number as the second argument.
	-- Values below 0 or above 1 for the acceleration argument do not make sense.
	SmartAssert(typeof(transparency) == "number", "Transparency isn't a number");
	SmartAssert(typeof(acceleration) == "number", "Acceleration isn't a number");

	self.TransparencyTarget = transparency;
	self.TransparencyAcceleration = math.clamp(acceleration, 0, 1);
end

function Stroke:SetColor(color: Color3, acceleration: number)
	-- Accepts a Color3 as the first argument and a number as the second argument.
	-- Values below 0 or above 1 for the acceleration argument do not make sense.
	SmartAssert(typeof(color) == "Color3", "Color isn't a Color3");
	SmartAssert(typeof(acceleration) == "number", "Acceleration isn't a number");

	self.ColorTarget = color;
	self.ColorAcceleration = math.clamp(acceleration, 0, 1);
end

function Stroke:SetScaledSize(useScaledSize: boolean)
	SmartAssert(typeof(useScaledSize) == "boolean", "useScaledSize isn't a boolean");

	if (useScaledSize) then
		self.Instance.StrokeSizingMode = Enum.StrokeSizingMode.ScaledSize;
	else
		self.Instance.StrokeSizingMode = Enum.StrokeSizingMode.FixedSize;
	end;
end

function Stroke:Pause()
	self.IsPaused = true;
end

function Stroke:Resume()
	self.IsPaused = false;
end

function Stroke:Destroy()
	self.Connection:Disconnect();
	if (self.Instance) then
		self.Instance:Destroy();
		self.Instance = nil;
	end;
end

return table.freeze(Stroke);</string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="203">
              <Properties>
                <string name="Name">Util</string>
                <string name="Source"><![CDATA[local function SmartAssert(condition: boolean, message: string)
	if (not condition) then
		error(message, 2);
	end;
end

return SmartAssert :: (boolean, string) -> ();
]]></string>
