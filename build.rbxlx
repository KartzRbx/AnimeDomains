            <string name="Source"><![CDATA[
--!strict

const ContextActionService = game:GetService("ContextActionService")
const ReplicatedStorage = game:GetService("ReplicatedStorage")

const Jabby = require(ReplicatedStorage.Packages.jabby)

local Client = Jabby.obtain_client()
local IsOpen = false

local function ToggleJabby(_, state: Enum.UserInputState)
	if state ~= Enum.UserInputState.Begin then
		return
	end

	if IsOpen then
		Client.unmount_all()
		IsOpen = false
		return
	end

	Client.spawn_app(Client.apps.home, nil)
	IsOpen = true
end

ContextActionService:BindAction("ToggleJabbyHome", ToggleJabby, false, Enum.KeyCode.F4)
]]></string>
