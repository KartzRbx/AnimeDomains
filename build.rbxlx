          <Item class="ModuleScript" referent="546">
            <Properties>
              <string name="Name">CardsServiceClient</string>
              <string name="Source"><![CDATA[--!strict

const Players = game:GetService("Players")
const ReplicatedStorage = game:GetService("ReplicatedStorage")

const UnitsMetaData = require(ReplicatedStorage.Shareds.Classes.Tree.Build.MetaData.UnitsMetaData)
const GameplayTypes = require(ReplicatedStorage.Shareds.Services.GameplayService.GameplayTypes)
const Net = require(ReplicatedStorage.Shareds.Networker.Net)

local CardServiceClient = {}

function CardServiceClient.RenderDeck(self: CardServiceClient, deck: { string })
	const playerGui = Players.LocalPlayer:WaitForChild("PlayerGui") :: PlayerGui
	local screenGui = self.DeckGui

	if not screenGui or not screenGui.Parent then
		screenGui = Instance.new("ScreenGui")
		screenGui.Name = "CardsHUD"
		screenGui.DisplayOrder = 100
		screenGui.IgnoreGuiInset = true
		screenGui.ResetOnSpawn = false
		screenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
		screenGui.Parent = playerGui
		self.DeckGui = screenGui
	end

	local container = self.DeckContainer
	if not container or not container.Parent then
		container = Instance.new("Frame")
		container.Name = "Deck"
		container.AnchorPoint = Vector2.new(0.5, 1)
		container.Position = UDim2.new(0.5, 0, 1, -24)
		container.Size = UDim2.new(1, -32, 0, 142)
		container.BackgroundTransparency = 1
		container.Parent = screenGui
		self.DeckContainer = container

		const listLayout = Instance.new("UIListLayout")
		listLayout.Name = "CardList"
		listLayout.FillDirection = Enum.FillDirection.Horizontal
		listLayout.HorizontalAlignment = Enum.HorizontalAlignment.Center
		listLayout.VerticalAlignment = Enum.VerticalAlignment.Center
		listLayout.Padding = UDim.new(0, 10)
		listLayout.SortOrder = Enum.SortOrder.LayoutOrder
		listLayout.Parent = container
	end

	for _, child in container:GetChildren() do
		if child:IsA("GuiObject") then
			child:Destroy()
		end
	end

	local cardDataById = self.CardDataById
	if not cardDataById then
		cardDataById = {}
		for _, cardData in UnitsMetaData.getAll() do
			cardDataById[cardData.Id] = cardData
		end
		self.CardDataById = cardDataById
	end

	for index, cardId in deck do
		const cardData = cardDataById[cardId]

		const card = Instance.new("ImageButton")
		card.Name = `Card_{index}`
		card.LayoutOrder = index
		card.Size = UDim2.fromOffset(92, 128)
		card.BackgroundColor3 = Color3.fromRGB(24, 27, 38)
		card.BorderSizePixel = 0
		card.AutoButtonColor = false
		card.Image = if cardData then cardData.CardImage else ""
		card.ScaleType = Enum.ScaleType.Crop
		card:SetAttribute("CardId", cardId)
		card.Parent = container

		const corner = Instance.new("UICorner")
		corner.CornerRadius = UDim.new(0, 10)
		corner.Parent = card

		const stroke = Instance.new("UIStroke")
		stroke.Color = Color3.fromRGB(226, 204, 119)
		stroke.Thickness = 2
		stroke.Parent = card

		const nameLabel = Instance.new("TextLabel")
		nameLabel.Name = "CardName"
		nameLabel.AnchorPoint = Vector2.new(0.5, 1)
		nameLabel.Position = UDim2.new(0.5, 0, 1, -5)
		nameLabel.Size = UDim2.new(1, -10, 0, 24)
		nameLabel.BackgroundColor3 = Color3.fromRGB(12, 14, 21)
		nameLabel.BackgroundTransparency = 0.2
		nameLabel.BorderSizePixel = 0
		nameLabel.Font = Enum.Font.GothamBold
		nameLabel.Text = if cardData then cardData.Name else cardId
		nameLabel.TextColor3 = Color3.new(1, 1, 1)
		nameLabel.TextScaled = true
		nameLabel.TextStrokeTransparency = 0.65
		nameLabel.Parent = card

		const namePadding = Instance.new("UIPadding")
		namePadding.PaddingLeft = UDim.new(0, 4)
		namePadding.PaddingRight = UDim.new(0, 4)
		namePadding.Parent = nameLabel

		if cardData then
			const energyLabel = Instance.new("TextLabel")
			energyLabel.Name = "EnergyCost"
			energyLabel.Position = UDim2.fromOffset(5, 5)
			energyLabel.Size = UDim2.fromOffset(28, 28)
			energyLabel.BackgroundColor3 = Color3.fromRGB(85, 53, 170)
			energyLabel.BorderSizePixel = 0
			energyLabel.Font = Enum.Font.GothamBold
			energyLabel.Text = tostring(cardData.EnergyCost)
			energyLabel.TextColor3 = Color3.new(1, 1, 1)
			energyLabel.TextScaled = true
			energyLabel.Parent = card

			const energyCorner = Instance.new("UICorner")
			energyCorner.CornerRadius = UDim.new(1, 0)
			energyCorner.Parent = energyLabel
		end
	end
end

function CardServiceClient.OnEntityState(self: CardServiceClient, state: GameplayTypes.EntityState)
	local localPlayer = Players.LocalPlayer

	if state.One.Owner ~= localPlayer.Name then
		return
	end

	self:RenderDeck(state.One.Data.Deck)
end

function CardServiceClient.Init(self: CardServiceClient)
	if self.Initialized then
		return self
	end

	self.Initialized = true

	Net.EntityStateClient.listen(function(state: GameplayTypes.EntityState)
		self:OnEntityState(state)
	end)

	return self
end

type CardServiceClient = typeof(CardServiceClient) & {
	Initialized: boolean,
	DeckGui: ScreenGui?,
	DeckContainer: Frame?,
	CardDataById: { [string]: UnitsMetaData.UnitCardParams }?,
}

return CardServiceClient
]]></string>
