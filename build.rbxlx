	BaseHealth = 1200,
	BaseDamage = 140,
	BaseRange = 18,
	EnergyCost = 0,
	Position = Vector3.zero,
	Walk = 0,
	TargetKind = "All",
	Upgrade = table.freeze({
		DamagePerLevel = 140,
		HealthPerLevel = 140,
		RangePerLevel = 1,
	}),
}

return TowerMetaData.new(Tower)
