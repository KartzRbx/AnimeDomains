            <string name="Source"><![CDATA[--!strict
-- Funcionamento: facade — EntityHelp + World + jecs num require só

const ReplicatedStorage = game:GetService("ReplicatedStorage")
const jecs = require(ReplicatedStorage.Packages.jecs)
const ID = require(ReplicatedStorage.Shareds.Classes.Tree.Build.Components.Primitives.ID)
const EntityHelper = require(ReplicatedStorage.Shareds.Workers.EntityHelper)
const World = jecs.World.new(true)

const Utils = {
	GetUnitMetadataWithID = function(UnitID: string)
		for entity, id in World:query(ID) do
			if id == UnitID then
				return World:get(entity)
			end
		end
	end

}

return {
	Entitys = EntityHelper,
	World = World,
	Jecs = jecs,
	Utils = Utils
}

