	RangePerLevel: number,
}

export type UnitData = {
	Id: string,
	Name: string,
	Level: number,
	BaseHealth: number,
	BaseDamage: number,
	BaseRange: number,
	DelayAttack: number,
	EnergyCost: number,
	CardImage: string,
	ModelID: string,
	Position: Vector3,
	Walk: number,
	Velocity: Vector3,
	TargetKind: UnitTargetKind,
	CanRetargetTroops: boolean,
	Upgrade: UnitUpgradeData,
}

const Unit: UnitData = {
	Id = "Sabre",
	Name = "Sabre",
	Level = 1,
	BaseHealth = 500,
	BaseDamage = 80,
	BaseRange = 5,
	Class = 'S',
	DelayAttack = 1,
	EnergyCost = 3,
	CardImage = Icons.Cards.Units.Sabre.Front,
	ModelID = "Sabre",
