        <Item class="ModuleScript" referent="558">
          <Properties>
            <string name="Name">CollisionGroupUtil</string>
            <string name="Source"><![CDATA[--!strict
-- Funcionamento: Players ↔ Entities não colidem; EntityBarriers bloqueiam Units, não Players

const Players = game:GetService("Players")
const PhysicsService = game:GetService("PhysicsService")
const RunService = game:GetService("RunService")

export type CollisionGroupName = "Players" | "Entities" | "EntityBarriers"

const GROUP_PLAYERS: CollisionGroupName = "Players"
const GROUP_ENTITIES: CollisionGroupName = "Entities"
const GROUP_ENTITY_BARRIERS: CollisionGroupName = "EntityBarriers"

local registered = false
local playerHooked = false

const function ensureGroup(name: CollisionGroupName)
	if not RunService:IsServer() then
		return
	end
	pcall(function()
		PhysicsService:RegisterCollisionGroup(name)
	end)
end

const function applyGroup(instance: Instance, group: CollisionGroupName)
	if instance:IsA("BasePart") then
		instance.CollisionGroup = group
	end
end

const function applyGroupRecursive(root: Instance, group: CollisionGroupName)
	applyGroup(root, group)
	for _, descendant in root:GetDescendants() do
		applyGroup(descendant, group)
	end
end

local CollisionGroupsUtils = {}

function CollisionGroupsUtils.Init()
	if registered then
		return
	end
	registered = true

	if RunService:IsServer() then
		ensureGroup(GROUP_PLAYERS)
		ensureGroup(GROUP_ENTITIES)
		ensureGroup(GROUP_ENTITY_BARRIERS)

		-- Players atravessam tropas e barreiras de entity
		PhysicsService:CollisionGroupSetCollidable(GROUP_PLAYERS, GROUP_ENTITIES, false)
		PhysicsService:CollisionGroupSetCollidable(GROUP_PLAYERS, GROUP_ENTITY_BARRIERS, false)
		-- Units batem nas barreiras (pathfinder / física)
		PhysicsService:CollisionGroupSetCollidable(GROUP_ENTITIES, GROUP_ENTITY_BARRIERS, true)

		if not playerHooked then
			playerHooked = true

			local function hookCharacter(character: Model)
				applyGroupRecursive(character, GROUP_PLAYERS)
				character.DescendantAdded:Connect(function(descendant)
					applyGroup(descendant, GROUP_PLAYERS)
				end)
			end

			local function hookPlayer(player: Player)
				if player.Character then
					hookCharacter(player.Character)
				end
				player.CharacterAdded:Connect(hookCharacter)
			end

			for _, player in Players:GetPlayers() do
				hookPlayer(player)
			end
			Players.PlayerAdded:Connect(hookPlayer)
		end
	end
end

function CollisionGroupsUtils.AssignEntity(model: Model)
	if RunService:IsServer() and not registered then
		CollisionGroupsUtils.Init()
	end
	applyGroupRecursive(model, GROUP_ENTITIES)
	model.DescendantAdded:Connect(function(descendant)
		applyGroup(descendant, GROUP_ENTITIES)
	end)
end

-- Build.EntityLimitations: CanCollide + PathfindingModifier (NavMesh desvia)
function CollisionGroupsUtils.AssignEntityBarriers(root: Instance)
	if RunService:IsServer() and not registered then
		CollisionGroupsUtils.Init()
	end

	local function configurePart(part: BasePart)
		part.CanCollide = true
		part.Anchored = true
		part.CollisionGroup = GROUP_ENTITY_BARRIERS

		local mod = part:FindFirstChildOfClass("PathfindingModifier")
		if not mod then
			mod = Instance.new("PathfindingModifier")
			mod.Parent = part
		end
		mod.Label = "EntityBarrier"
		mod.PassThrough = false
	end

	for _, descendant in root:GetDescendants() do
		if descendant:IsA("BasePart") then
			configurePart(descendant)
		end
	end
	if root:IsA("BasePart") then
		configurePart(root)
	end
end

CollisionGroupsUtils.Players = GROUP_PLAYERS
CollisionGroupsUtils.Entities = GROUP_ENTITIES
CollisionGroupsUtils.EntityBarriers = GROUP_ENTITY_BARRIERS

return CollisionGroupsUtils
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="559">
          <Properties>
            <string name="Name">CollisionGroupsUtils</string>
            <string name="Source"><![CDATA[--!strict

return require(script.Parent.CollisionGroupUtil)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="560">
          <Properties>
            <string name="Name">PlacementZoneUtil</string>
            <string name="Source"><![CDATA[--!strict
-- Funcionamento: zona EntitySpawn do próprio time — Units/Structures; Spells ignoram

--[[
	Template FlorestMap (MCP):
	Teams.One.Interactions.EntitySpawn  → Union @ Z≈133 (lado One)
	Teams.Two.Interactions.EntitySpawn  → Union @ Z≈218 (lado Two)
	BuildMap clona para Workspace.Game.Gameplay.Teams.<Team>.Interactions
]]

const Workspace = game:GetService("Workspace")

export type TeamName = "One" | "Two"
export type PlaceKind = "Unit" | "Spell" | "Structure"

-- Folga XZ se o click no chão fica um pouco fora da superfície da Union
const SURFACE_XZ_TOLERANCE = 2.5

local PlacementZoneUtils = {}

function PlacementZoneUtils.RequiresEntitySpawnZone(kind: PlaceKind): boolean
	return kind == "Unit" or kind == "Structure"
end

const function getTeamsRoot(): Folder?
	local gameFolder = Workspace:FindFirstChild("Game")
	local gameplay = gameFolder and gameFolder:FindFirstChild("Gameplay")
	local teams = gameplay and gameplay:FindFirstChild("Teams")
	if teams and teams:IsA("Folder") then
		return teams
	end
	return nil
end

-- Aceita Part ou UnionOperation (FlorestMap usa Union)
function PlacementZoneUtils.GetEntitySpawn(teamName: TeamName): BasePart?
	local teamsRoot = getTeamsRoot()
	local teamFolder = teamsRoot and teamsRoot:FindFirstChild(teamName)
	local interactions = teamFolder and teamFolder:FindFirstChild("Interactions")
	local spawnZone = interactions and interactions:FindFirstChild("EntitySpawn")
	if spawnZone and spawnZone:IsA("BasePart") then
		return spawnZone
	end
	return nil
end

-- AABB local do BasePart (Size/CFrame da Union = bounding box)
function PlacementZoneUtils.IsPointInPart(worldPos: Vector3, part: BasePart): boolean
	local localPoint = part.CFrame:PointToObjectSpace(worldPos)
	local half = part.Size * 0.5
	local yPad = math.max(half.Y, 8)
	return math.abs(localPoint.X) <= half.X + 0.05
		and math.abs(localPoint.Z) <= half.Z + 0.05
		and math.abs(localPoint.Y) <= yPad
end

-- Union/Mesh: AABB + superfície real (não aceita cantos vazios da bounding box)
function PlacementZoneUtils.IsPointInZone(worldPos: Vector3, part: BasePart): boolean
	if not PlacementZoneUtils.IsPointInPart(worldPos, part) then
		return false
	end

	if part:IsA("UnionOperation") or part:IsA("MeshPart") then
		local closest = part:GetClosestPointOnSurface(worldPos)
		local dx = worldPos.X - closest.X
		local dz = worldPos.Z - closest.Z
		return (dx * dx + dz * dz) <= (SURFACE_XZ_TOLERANCE * SURFACE_XZ_TOLERANCE)
	end

	return true
end

function PlacementZoneUtils.CanPlace(
	teamName: TeamName,
	worldPos: Vector3,
	kind: PlaceKind
): boolean
	if not PlacementZoneUtils.RequiresEntitySpawnZone(kind) then
		return true
	end

	local zone = PlacementZoneUtils.GetEntitySpawn(teamName)
	if not zone then
		warn("PlacementZoneUtils: EntitySpawn missing for team", teamName)
		return false
	end

	return PlacementZoneUtils.IsPointInZone(worldPos, zone)
end

return PlacementZoneUtils
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="561">
          <Properties>
            <string name="Name">VFXUtil</string>
            <string name="Source"><![CDATA[--!strict
-- Funcionamento: clona VFX (Attachment/emitters), EmitAll/For/Excluded, sinal Completed

const ReplicatedStorage = game:GetService("ReplicatedStorage")
const Debris = game:GetService("Debris")
const Signal = require(ReplicatedStorage.Packages.signal)
const AssetsUtils = require(ReplicatedStorage.Shareds.Utils.AssetsUtils)

export type EffectName = string
export type EmitterName = string

export type EffectPlayback = {
	Completed: typeof(Signal.new()),
	Instance: Instance,
	Destroy: (self: EffectPlayback) -> (),
	_destroyed: boolean,
}

export type VisualEffectsUtils = {
	EmitAll: (source: Instance | Animation, parent: Instance) -> EffectPlayback,
	EmitFor: (source: Instance | Animation, parent: Instance, emitterNames: { EmitterName }) -> EffectPlayback,
	EmitExcluded: (source: Instance | Animation, parent: Instance, excludedNames: { EmitterName }) -> EffectPlayback,
}

local VisualEffectsUtils = {} :: VisualEffectsUtils

const function resolveEffectTemplate(source: Instance | Animation): Instance
	if source:IsA("Animation") then
		local linked = source:GetAttribute("Parent") or source:GetAttribute("Parrent")
		assert(typeof(linked) == "string" and linked ~= "", "Animation precisa do Attribute Parent (nome do effect)")
		return AssetsUtils.getGameplayEntityEffect(linked :: string)
	end
	return source
end

const function collectEmitters(root: Instance): { ParticleEmitter }
	local emitters: { ParticleEmitter } = {}
	if root:IsA("ParticleEmitter") then
		table.insert(emitters, root)
	end
	for _, descendant in root:GetDescendants() do
		if descendant:IsA("ParticleEmitter") then
			table.insert(emitters, descendant)
		end
	end
	return emitters
end

const function filterEmitters(
	emitters: { ParticleEmitter },
	mode: "all" | "for" | "excluded",
	names: { EmitterName }?
): { ParticleEmitter }
	if mode == "all" or not names then
		return emitters
	end

	local nameSet: { [string]: boolean } = {}
	for _, name in names do
		nameSet[name] = true
	end

	local filtered: { ParticleEmitter } = {}
	for _, emitter in emitters do
		local included = nameSet[emitter.Name] == true
		if mode == "for" and included then
			table.insert(filtered, emitter)
		elseif mode == "excluded" and not included then
			table.insert(filtered, emitter)
		end
	end
	return filtered
end

const function burstCount(emitter: ParticleEmitter): number
	local attr = emitter:GetAttribute("EmitCount")
	if typeof(attr) == "number" and attr > 0 then
		return math.floor(attr)
	end
	if emitter.Rate > 0 then
		return math.max(1, math.ceil(emitter.Rate))
	end
	return 16
end

const function maxLifetime(emitters: { ParticleEmitter }): number
	local longest = 0.5
	for _, emitter in emitters do
		local life = emitter.Lifetime.Max
		if life > longest then
			longest = life
		end
	end
	return longest
end

const function findAttachParent(parent: Instance): Instance
	if parent:IsA("BasePart") or parent:IsA("Attachment") then
		return parent
	end
	if parent:IsA("Model") then
		local hrp = parent:FindFirstChild("HumanoidRootPart")
		if hrp and hrp:IsA("BasePart") then
			return hrp
		end
		local primary = parent.PrimaryPart
		if primary then
			return primary
		end
	end
	if parent:IsA("Humanoid") then
		local character = parent.Parent
		if character and character:IsA("Model") then
			local hrp = character:FindFirstChild("HumanoidRootPart")
			if hrp and hrp:IsA("BasePart") then
				return hrp
			end
		end
	end
	return parent
end

const function cloneUnderParent(template: Instance, parent: Instance): Instance
	local attachParent = findAttachParent(parent)
	local clone = template:Clone()
	clone.Parent = attachParent
	return clone
end

const function createPlayback(clone: Instance, emitters: { ParticleEmitter }): EffectPlayback
	local playback = {
		Completed = Signal.new(),
		Instance = clone,
		_destroyed = false,
	} :: EffectPlayback

	function playback.Destroy(self: EffectPlayback)
		if self._destroyed then
			return
		end
		self._destroyed = true
		if self.Instance.Parent then
			self.Instance:Destroy()
		end
		self.Completed:Destroy()
	end

	for _, emitter in emitters do
		emitter:Emit(burstCount(emitter))
	end

	local lifetime = maxLifetime(emitters) + 0.15
	task.delay(lifetime, function()
		if playback._destroyed then
			return
		end
		playback.Completed:Fire()
		playback:Destroy()
	end)

	-- Safety se Completed nunca for ouvido
	Debris:AddItem(clone, lifetime + 2)

	return playback
end

const function emitInternal(
	source: Instance | Animation,
	parent: Instance,
	mode: "all" | "for" | "excluded",
	names: { EmitterName }?
): EffectPlayback
	local template = resolveEffectTemplate(source)
	local clone = cloneUnderParent(template, parent)
	local emitters = filterEmitters(collectEmitters(clone), mode, names)
	assert(#emitters > 0, "VisualEffectsUtils: nenhum ParticleEmitter para emitir")
	return createPlayback(clone, emitters)
end

function VisualEffectsUtils.EmitAll(source: Instance | Animation, parent: Instance): EffectPlayback
	return emitInternal(source, parent, "all", nil)
end

function VisualEffectsUtils.EmitFor(
	source: Instance | Animation,
	parent: Instance,
	emitterNames: { EmitterName }
): EffectPlayback
	return emitInternal(source, parent, "for", emitterNames)
end

function VisualEffectsUtils.EmitExcluded(
	source: Instance | Animation,
	parent: Instance,
	excludedNames: { EmitterName }
): EffectPlayback
	return emitInternal(source, parent, "excluded", excludedNames)
end

return VisualEffectsUtils
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="562">
          <Properties>
            <string name="Name">AnimationUtil</string>
            <string name="Source"><![CDATA[--!strict
-- Funcionamento: resolve Anims (_Universal vs Tower/Unit Id) e controla play via Signal

const ReplicatedStorage = game:GetService("ReplicatedStorage")
const Signal = require(ReplicatedStorage.Packages.signal)
const AssetsUtils = require(ReplicatedStorage.Shareds.Utils.AssetsUtils)

export type EntityKind = "Tower" | "Unit"
export type AnimName = string
export type EntityId = string

export type AnimationPlayer = {
	Play: (self: AnimationPlayer, name: AnimName) -> (),
	SetSpeed: (self: AnimationPlayer, speed: number) -> (),
	Pause: (self: AnimationPlayer) -> (),
	Destroy: (self: AnimationPlayer) -> (),
	Played: typeof(Signal.new()),
	Paused: typeof(Signal.new()),
	_animator: Animator,
	_tracks: { [AnimName]: AnimationTrack },
	_currentName: AnimName?,
	_currentTrack: AnimationTrack?,
	_speed: number,
	_kind: EntityKind,
	_entityId: EntityId,
}

export type AnimationResolveUtils = {
	PrepareModel: (model: Model) -> Animator,
	ResolveAnimation: (kind: EntityKind, entityId: EntityId, animName: AnimName) -> Animation,
	Bind: (model: Model, kind: EntityKind, entityId: EntityId) -> AnimationPlayer,
}

local AnimationResolveUtils = {} :: AnimationResolveUtils

const function getOrCreateAnimator(humanoid: Humanoid): Animator
	local animator = humanoid:FindFirstChildOfClass("Animator")
	if animator then
		return animator
	end
	local created = Instance.new("Animator")
	created.Parent = humanoid
	return created
end

-- Desancora partes para o Motor6D/anim funcionar; HRP pode ser reancorado depois (tower)
function AnimationResolveUtils.PrepareModel(model: Model): Animator
	local humanoid = model:FindFirstChildOfClass("Humanoid")
	assert(humanoid, `AnimationResolveUtils: Humanoid missing on {model:GetFullName()}`)

	for _, descendant in model:GetDescendants() do
		if descendant:IsA("BasePart") then
			local keepAnchored = descendant:GetAttribute("KeepAnchored") == true
			if not keepAnchored then
				descendant.Anchored = false
			end
			-- HRP precisa colidir com o chão (pathfinder); membros não
			descendant.CanCollide = descendant.Name == "HumanoidRootPart"
		end
	end

	humanoid.PlatformStand = false
	return getOrCreateAnimator(humanoid)
end

function AnimationResolveUtils.ResolveAnimation(kind: EntityKind, entityId: EntityId, animName: AnimName): Animation
	return AssetsUtils.getEntityAnimation(kind, entityId, animName)
end

const function loadTrack(animator: Animator, animation: Animation): AnimationTrack
	return animator:LoadAnimation(animation)
end

const function createPlayer(animator: Animator, kind: EntityKind, entityId: EntityId): AnimationPlayer
	local player = {
		Played = Signal.new(),
		Paused = Signal.new(),
		_animator = animator,
		_tracks = {},
		_currentName = nil,
		_currentTrack = nil,
		_speed = 1,
		_kind = kind,
		_entityId = entityId,
	} :: AnimationPlayer

	function player.Play(self: AnimationPlayer, name: AnimName)
		if self._currentName == name and self._currentTrack and self._currentTrack.IsPlaying then
			return
		end

		local track = self._tracks[name]
		if not track then
			local animation = AnimationResolveUtils.ResolveAnimation(self._kind, self._entityId, name)
			track = loadTrack(self._animator, animation)
			track.Looped = (name == "Idle" or name == "Walk")
			self._tracks[name] = track
		end

		if self._currentTrack and self._currentTrack ~= track then
			self._currentTrack:Stop(0.1)
		end

		track:Play(0.1)
		track:AdjustSpeed(self._speed)
		self._currentTrack = track
		self._currentName = name
		self.Played:Fire(name)
	end

	function player.SetSpeed(self: AnimationPlayer, speed: number)
		self._speed = speed
		if self._currentTrack then
			self._currentTrack:AdjustSpeed(speed)
		end
	end

	function player.Pause(self: AnimationPlayer)
		if not self._currentTrack or not self._currentName then
			return
		end
		self._currentTrack:AdjustSpeed(0)
		self.Paused:Fire(self._currentName)
	end

	function player.Destroy(self: AnimationPlayer)
		for _, track in self._tracks do
			track:Stop(0)
			track:Destroy()
		end
		table.clear(self._tracks)
		self._currentTrack = nil
		self._currentName = nil
		self.Played:Destroy()
		self.Paused:Destroy()
	end

	return player
end

function AnimationResolveUtils.Bind(model: Model, kind: EntityKind, entityId: EntityId): AnimationPlayer
	local animator = AnimationResolveUtils.PrepareModel(model)
	return createPlayer(animator, kind, entityId)
end

return AnimationResolveUtils
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="563">
          <Properties>
            <string name="Name">AssetsUtil</string>
            <string name="Source"><![CDATA[--!strict
-- Funcionamento: resolve templates em ReplicatedStorage.Assets (Studio, não Rojo)

--[[
	Estrutura canônica (Studio):

	ReplicatedStorage.Assets/
	├── Miscs/
	├── Models/
	│   └── Gameplay/
	│       ├── Maps/<MapId>
	│       └── Entitys/
	│           ├── Tower/<Id>   -- ex: Dummy (R6)
	│           └── Unit/<Id>
	├── Animations/
	│   ├── Player/...
	│   └── Gameplay/Entitys/
	│       ├── _Universal/ Idle, Walk
	│       ├── Tower/<Id>/ Attack, ...
	│       └── Units/<Id>/ ...
	├── Effects/
	│   └── Gameplay/Entitys/SpawnEffect
	└── Sounds/
	    ├── Gameplay/
	    │   ├── Attacks/
	    │   └── Effects/TowersSpawned
	    └── Interface/
	        ├── Effects/
	        ├── Interactions/
	        └── Windows/
]]

const ReplicatedStorage = game:GetService("ReplicatedStorage")

export type MiscCategory = string
export type ModelCategory = string
export type TemplateName = string
export type MapName = string
export type SoundName = string
export type AnimationName = string
export type EffectName = string
export type SoundCategory = "Effects" | "Attacks"
export type InterfaceSoundCategory = "Effects" | "Interactions" | "Windows"
export type GameplayModelCategory = string
export type EntityKind = "Tower" | "Unit"
export type EntityId = string
export type AnimName = string

export type AssetsUtils = {
	getMiscTemplate: (category: MiscCategory, templateName: TemplateName) -> Instance,
	getModelTemplate: (category: ModelCategory, templateName: TemplateName) -> Instance,
	getGameplayModel: (category: GameplayModelCategory, templateName: TemplateName) -> Instance,
	getEntityTowerModel: (entityId: EntityId) -> Model,
	getEntityUnitModel: (entityId: EntityId) -> Model,
	getMaps: (mapName: MapName) -> Instance,
	getSound: (soundName: SoundName) -> Instance,
	getAnimation: (animationName: AnimationName) -> Instance,
	getEntityAnimation: (kind: EntityKind, entityId: EntityId, animName: AnimName) -> Animation,
	getEffect: (effectName: EffectName) -> Instance,
	getGameplayEntityEffect: (effectName: EffectName) -> Instance,
	getGameplayEffectSound: (soundName: SoundName) -> Sound,
	getGameplayAttackSound: (soundName: SoundName) -> Sound,
	getGameplaySound: (category: SoundCategory, soundName: SoundName) -> Sound,
	getInterfaceSound: (category: InterfaceSoundCategory, soundName: SoundName) -> Sound,
	getTowerBillboard: () -> BillboardGui,
	getUnitRangeCircle: () -> Model,
}

local AssetsUtils = {} :: AssetsUtils

const function getAssetsRoot(): Folder
	local assets = ReplicatedStorage:WaitForChild("Assets")
	assert(assets:IsA("Folder"), "ReplicatedStorage.Assets must be a Folder")
	return assets
end

const function waitFolder(parent: Instance, name: string): Folder
	local folder = parent:WaitForChild(name)
	assert(folder:IsA("Folder"), `Assets/{name} must be a Folder`)
	return folder
end

const function findTemplate(parent: Instance, templateName: string, pathLabel: string): Instance
	local template = parent:FindFirstChild(templateName)
	assert(template, `Template not found: {pathLabel}/{templateName}`)
	return template
end

const function getGameplayRoot(): Folder
	local models = waitFolder(getAssetsRoot(), "Models")
	return waitFolder(models, "Gameplay")
end

const function getEntityAnimsRoot(): Folder
	local animations = waitFolder(getAssetsRoot(), "Animations")
	local gameplay = waitFolder(animations, "Gameplay")
	return waitFolder(gameplay, "Entitys")
end

-- Miscs/<category>/<template>
function AssetsUtils.getMiscTemplate(category: MiscCategory, templateName: TemplateName): Instance
	local miscs = waitFolder(getAssetsRoot(), "Miscs")
	local categoryFolder = waitFolder(miscs, category)
	return findTemplate(categoryFolder, templateName, `Assets/Miscs/{category}`)
end

function AssetsUtils.getModelTemplate(category: ModelCategory, templateName: TemplateName): Instance
	local models = waitFolder(getAssetsRoot(), "Models")
	local categoryFolder = waitFolder(models, category)
	return findTemplate(categoryFolder, templateName, `Assets/Models/{category}`)
end

function AssetsUtils.getGameplayModel(category: GameplayModelCategory, templateName: TemplateName): Instance
	local gameplay = getGameplayRoot()
	local categoryFolder = waitFolder(gameplay, category)
	return findTemplate(categoryFolder, templateName, `Assets/Models/Gameplay/{category}`)
end

-- Models/Gameplay/Entitys/Tower/<Id>
function AssetsUtils.getEntityTowerModel(entityId: EntityId): Model
	local gameplay = getGameplayRoot()
	local entitys = waitFolder(gameplay, "Entitys")
	local towerFolder = waitFolder(entitys, "Tower")
	local template = findTemplate(towerFolder, entityId, "Assets/Models/Gameplay/Entitys/Tower")
	assert(template:IsA("Model"), `Tower entity must be Model: {entityId}`)
	return template
end

-- Models/Gameplay/Entitys/Unit/<Id>
function AssetsUtils.getEntityUnitModel(entityId: EntityId): Model
	local gameplay = getGameplayRoot()
	local entitys = waitFolder(gameplay, "Entitys")
	local unitFolder = waitFolder(entitys, "Unit")
	local template = findTemplate(unitFolder, entityId, "Assets/Models/Gameplay/Entitys/Unit")
	assert(template:IsA("Model"), `Unit entity must be Model: {entityId}`)
	return template
end

function AssetsUtils.getMaps(mapName: MapName): Instance
	local gameplay = getGameplayRoot()
	local maps = waitFolder(gameplay, "Maps")
	return findTemplate(maps, mapName, "Assets/Models/Gameplay/Maps")
end

function AssetsUtils.getSound(soundName: SoundName): Instance
	local sounds = waitFolder(getAssetsRoot(), "Sounds")
	return findTemplate(sounds, soundName, "Assets/Sounds")
end

function AssetsUtils.getAnimation(animationName: AnimationName): Instance
	local animations = waitFolder(getAssetsRoot(), "Animations")
	return findTemplate(animations, animationName, "Assets/Animations")
end

--[[
	Resolve: Entitys/Tower|<Units>/<Id>/<Anim> se existir,
	senão Entitys/_Universal/<Anim> (Idle/Walk compartilhado).
	Obs: pasta Units (plural) nas Animações; Unit (singular) nos Models.
]]
function AssetsUtils.getEntityAnimation(kind: EntityKind, entityId: EntityId, animName: AnimName): Animation
	local entitys = getEntityAnimsRoot()
	local kindFolderName = if kind == "Tower" then "Tower" else "Units"
	local kindFolder = entitys:FindFirstChild(kindFolderName)

	if kindFolder and kindFolder:IsA("Folder") then
		local idFolder = kindFolder:FindFirstChild(entityId)
		if idFolder and idFolder:IsA("Folder") then
			local specific = idFolder:FindFirstChild(animName)
			if specific and specific:IsA("Animation") then
				return specific
			end
		end
	end

	local universal = waitFolder(entitys, "_Universal")
	local fallback = findTemplate(universal, animName, "Assets/Animations/Gameplay/Entitys/_Universal")
	assert(fallback:IsA("Animation"), `Universal anim missing: {animName}`)
	return fallback
end

function AssetsUtils.getEffect(effectName: EffectName): Instance
	local effects = waitFolder(getAssetsRoot(), "Effects")
	return findTemplate(effects, effectName, "Assets/Effects")
end

-- Effects/Gameplay/Entitys/<name>  ex: SpawnEffect (Attachment)
function AssetsUtils.getGameplayEntityEffect(effectName: EffectName): Instance
	local effects = waitFolder(getAssetsRoot(), "Effects")
	local gameplay = waitFolder(effects, "Gameplay")
	local entitys = waitFolder(gameplay, "Entitys")
	return findTemplate(entitys, effectName, "Assets/Effects/Gameplay/Entitys")
end

-- Sounds/Gameplay/Effects/<name>  ex: TowersSpawned
function AssetsUtils.getGameplayEffectSound(soundName: SoundName): Sound
	return AssetsUtils.getGameplaySound("Effects", soundName)
end

-- Sounds/Gameplay/Attacks/<name>
function AssetsUtils.getGameplayAttackSound(soundName: SoundName): Sound
	return AssetsUtils.getGameplaySound("Attacks", soundName)
end

-- Sounds/Gameplay/<Effects|Attacks>/<name>
function AssetsUtils.getGameplaySound(category: SoundCategory, soundName: SoundName): Sound
	local sounds = waitFolder(getAssetsRoot(), "Sounds")
	local gameplay = waitFolder(sounds, "Gameplay")
	local categoryFolder = waitFolder(gameplay, category)
	local template = findTemplate(categoryFolder, soundName, `Assets/Sounds/Gameplay/{category}`)
	assert(template:IsA("Sound"), `Expected Sound: Gameplay/{category}/{soundName}`)
	return template
end

-- Sounds/Interface/<Effects|Interactions|Windows>/<name>
function AssetsUtils.getInterfaceSound(category: InterfaceSoundCategory, soundName: SoundName): Sound
	local sounds = waitFolder(getAssetsRoot(), "Sounds")
	local interfaceFolder = waitFolder(sounds, "Interface")
	local categoryFolder = waitFolder(interfaceFolder, category)
	local template = findTemplate(categoryFolder, soundName, `Assets/Sounds/Interface/{category}`)
	assert(template:IsA("Sound"), `Expected Sound: Interface/{category}/{soundName}`)
	return template
end

-- Miscs/Gameplay/Entitys/Tower/TowerBillBoard
function AssetsUtils.getTowerBillboard(): BillboardGui
	local miscs = waitFolder(getAssetsRoot(), "Miscs")
	local gameplay = waitFolder(miscs, "Gameplay")
	local entitys = waitFolder(gameplay, "Entitys")
	local towerFolder = waitFolder(entitys, "Tower")
	local template = findTemplate(towerFolder, "TowerBillBoard", "Assets/Miscs/Gameplay/Entitys/Tower")
	assert(template:IsA("BillboardGui"), "TowerBillBoard must be BillboardGui")
	return template
end

-- Miscs/Gameplay/Entitys/Units/RangeCircle
function AssetsUtils.getUnitRangeCircle(): Model
	local miscs = waitFolder(getAssetsRoot(), "Miscs")
	local gameplay = waitFolder(miscs, "Gameplay")
	local entitys = waitFolder(gameplay, "Entitys")
	local units = entitys:FindFirstChild("Units") or entitys:FindFirstChild("Unit")
	assert(units and units:IsA("Folder"), "Assets/Miscs/Gameplay/Entitys/Units (ou Unit) missing")
	local template = findTemplate(units, "RangeCircle", "Assets/Miscs/Gameplay/Entitys/Units")
	assert(template:IsA("Model"), "RangeCircle must be Model")
	return template
end

return AssetsUtils
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="564">
          <Properties>
            <string name="Name">AssetsUtils</string>
            <string name="Source"><![CDATA[--!strict

return require(script.Parent.AssetsUtil)
]]></string>
