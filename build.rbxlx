        <Item class="Folder" referent="550">
          <Properties>
            <string name="Name">GameplayService</string>
          </Properties>
          <Item class="ModuleScript" referent="551">
            <Properties>
              <string name="Name">GameplayBuildMap</string>
              <string name="Source"><![CDATA[--!strict
-- Funcionamento: clona o Build do mapa e sincroniza Towers/PlayerSpawn/EntitySpawn.

const ReplicatedStorage = game:GetService("ReplicatedStorage")
const Workspace = game:GetService("Workspace")

const GameplayTypes = require(ReplicatedStorage.Shareds.Services.GameplayService.GameplayTypes)
const Islands = require(ReplicatedStorage.Shareds.Constants.Datas.Islands)
const CollisionGroupsUtils = require(ReplicatedStorage.Shareds.Utils.CollisionGroupsUtils)

const GameplayBuildMap = {}

export type GameplayBuildMap = typeof(GameplayBuildMap)

local function FindChild(parent: Instance?, name: string): Instance?
	if not parent then
		return nil
	end

	return parent:FindFirstChild(name)
end

local function GetOrCreateFolder(parent: Instance, name: string): Folder
	local folder = parent:FindFirstChild(name)

	if folder and folder:IsA("Folder") then
		return folder
	end

	local newFolder = Instance.new("Folder")
	newFolder.Name = name
	newFolder.Parent = parent
	return newFolder
end

local function GetGameFolder(): Folder
	return GetOrCreateFolder(Workspace, "Game")
end

local function GetBuildsFolder(): Folder
	return GetOrCreateFolder(GetGameFolder(), "Builds")
end

local function GetTeamsRoot(): Folder
	local gameplay = GetOrCreateFolder(GetGameFolder(), "Gameplay")
	return GetOrCreateFolder(gameplay, "Teams")
end

local function GetTeamFolder(teamName: string): Folder
	local teamFolder = GetOrCreateFolder(GetTeamsRoot(), teamName)
	GetOrCreateFolder(teamFolder, "Towers")
	GetOrCreateFolder(teamFolder, "Units")
	GetOrCreateFolder(teamFolder, "Players")
	GetOrCreateFolder(teamFolder, "Interactions")
	return teamFolder
end

local function ClearFolder(folder: Folder): ()
	for _, child in folder:GetChildren() do
		child:Destroy()
	end
end

local function ConfigureEntityLimitations(buildClone: Instance): ()
	local limitations = FindChild(buildClone, "EntityLimitations")

	if limitations then
		CollisionGroupsUtils.AssignEntityBarriers(limitations)
	end
end

local function CloneBuildToWorkspace(mapModel: Instance): boolean
	local sourceBuild = FindChild(mapModel, "Build") or FindChild(mapModel, "build")

	if not sourceBuild then
		warn("GameplayBuildMap: Build not found in map", mapModel.Name)
		return false
	end

	local buildsFolder = GetBuildsFolder()
	ClearFolder(buildsFolder)

	local buildClone = sourceBuild:Clone()
	buildClone.Parent = buildsFolder

	ConfigureEntityLimitations(buildClone)

	return true
end

local function SyncTowers(sourceTowers: Instance?, destinationTowers: Instance?): ()
	if not sourceTowers or not destinationTowers then
		return
	end

	for _, child in destinationTowers:GetChildren() do
		child:Destroy()
	end

	for _, towerModel in sourceTowers:GetChildren() do
		if towerModel:IsA("Model") or towerModel:IsA("BasePart") then
			local towerClone = towerModel:Clone()
			towerClone.Parent = destinationTowers
		end
	end
end

local function SyncInteractionPart(sourceInteractions: Instance, destinationInteractions: Instance, partName: string): ()
	local sourcePart = FindChild(sourceInteractions, partName)

	if not sourcePart then
		warn(`GameplayBuildMap: {partName} not found in source interactions`)
		return
	end

	local oldPart = FindChild(destinationInteractions, partName)
	if oldPart then
		oldPart:Destroy()
	end

	local partClone = sourcePart:Clone()

	if partClone:IsA("BasePart") then
		partClone.Anchored = true
		partClone.CanCollide = false
		partClone.CanTouch = false
		partClone.CanQuery = true

		if partName == "EntitySpawn" then
			partClone.Transparency = 1
			partClone.CastShadow = false
		end
	end

	partClone.Parent = destinationInteractions
end

local function SyncInteractions(sourceInteractions: Instance?, destinationInteractions: Instance?): ()
	if not sourceInteractions or not destinationInteractions then
		warn("GameplayBuildMap: Interactions folder missing while syncing team")
		return
	end

	SyncInteractionPart(sourceInteractions, destinationInteractions, "PlayerSpawn")
	SyncInteractionPart(sourceInteractions, destinationInteractions, "EntitySpawn")
end

local function SyncTeam(sourceTeam: Instance): ()
	local destinationTeam = GetTeamFolder(sourceTeam.Name)
	local sourceInteractions = FindChild(sourceTeam, "Interactions")

	SyncTowers(FindChild(sourceTeam, "Towers"), FindChild(destinationTeam, "Towers"))
	SyncInteractions(sourceInteractions, FindChild(destinationTeam, "Interactions"))
end

function GameplayBuildMap.BuildMap(mapModel: Instance): GameplayTypes.Result
	assert(mapModel, "GameplayBuildMap.BuildMap: mapModel is nil")

	local buildCreated = CloneBuildToWorkspace(mapModel)

	if not buildCreated then
		return false
	end

	local sourceTeams = FindChild(mapModel, "Teams")

	if not sourceTeams then
		warn("GameplayBuildMap: Teams folder not found in map", mapModel.Name)
		return false
	end

	for _, sourceTeam in sourceTeams:GetChildren() do
		if sourceTeam:IsA("Model") or sourceTeam:IsA("Folder") then
			SyncTeam(sourceTeam)
		end
	end

	return true
end

function GameplayBuildMap.BindForMap(mapId: GameplayTypes.MapId): GameplayTypes.Result
	local ok, result = pcall(function()
		local mapModel = Islands.GetMapWithId(mapId)

		if not mapModel then
			warn(`GameplayBuildMap: island config not found: {mapId}`)
			return false
		end

		return GameplayBuildMap.BuildMap(mapModel)
	end)

	if not ok then
		warn("GameplayBuildMap error:", result)
		return false
	end

	return result
end

return GameplayBuildMap
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="552">
            <Properties>
              <string name="Name">GameplayServiceClient</string>
              <string name="Source"><![CDATA[--!strict

const ReplicatedStorage = game:GetService("ReplicatedStorage")

const GameplayTypes = require(script.Parent.GameplayTypes)
const Net = require(ReplicatedStorage.Shareds.Networker.Net)

const GameplayServiceClient = {
	Initialized = false,
	EntityState = nil :: GameplayTypes.EntityState?,
	Units = {} :: { [number]: GameplayTypes.UnitState },
	Energy = {
		Current = 0,
		Max = 0,
	} :: GameplayTypes.MatchEnergy,
}

export type GameplayServiceClient = typeof(GameplayServiceClient)

function GameplayServiceClient.ToVector3(position: GameplayTypes.Vec3Data): Vector3
	return Vector3.new(position.X, position.Y, position.Z)
end

function GameplayServiceClient.SetEntityState(self: GameplayServiceClient, state: GameplayTypes.EntityState): ()
	self.EntityState = state
	print("[GameplayServiceClient] Entity state received")
end

function GameplayServiceClient.SetEnergy(self: GameplayServiceClient, energy: GameplayTypes.MatchEnergy): ()
	self.Energy = energy
	print("[GameplayServiceClient] Energy:", energy.Current, "/", energy.Max)
end

function GameplayServiceClient.AddUnit(self: GameplayServiceClient, unit: GameplayTypes.UnitState): ()
	self.Units[unit.NetId] = unit
	print("[GameplayServiceClient] Unit spawned:", unit.CardId)
end

function GameplayServiceClient.UpdateUnit(self: GameplayServiceClient, unit: GameplayTypes.UnitUpdate): ()
	local oldUnit = self.Units[unit.NetId]

	if not oldUnit then
		return
	end

	oldUnit.Position = unit.Position
	oldUnit.Health = unit.Health
	oldUnit.Moving = unit.Moving
end

function GameplayServiceClient.RemoveUnit(self: GameplayServiceClient, netId: number): ()
	self.Units[netId] = nil
	print("[GameplayServiceClient] Unit removed:", netId)
end

function GameplayServiceClient.ListenPackets(self: GameplayServiceClient): ()
	Net.EntityStateClient.listen(function(state: GameplayTypes.EntityState)
		self:SetEntityState(state)
	end)

	Net.MatchEnergyClient.listen(function(energy: GameplayTypes.MatchEnergy)
		self:SetEnergy(energy)
	end)

	Net.UnitSpawnedClient.listen(function(unit: GameplayTypes.UnitState)
		self:AddUnit(unit)
	end)

	Net.UnitStateClient.listen(function(unit: GameplayTypes.UnitUpdate)
		self:UpdateUnit(unit)
	end)

	Net.UnitDespawnedClient.listen(function(data: GameplayTypes.UnitDespawn)
		self:RemoveUnit(data.NetId)
	end)
end

function GameplayServiceClient.Init(self: GameplayServiceClient): GameplayServiceClient
	assert(not self.Initialized, "GameplayServiceClient already initialized")

	self.Initialized = true
	self:ListenPackets()

	return self
end

return GameplayServiceClient
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="553">
            <Properties>
              <string name="Name">GameplayTypes</string>
              <string name="Source"><![CDATA[--!strict

export type MapId = string
export type Result = boolean
export type GameType = "Single" | "Multi"
export type MatchId = string
export type GameStatus = "Waiting" | "Running" | "Finished"

export type GameConfig = {
	MapId: MapId,
	GameType: GameType,
}

export type GameplayProperties = {
	Players: { string },
	GameConfig: GameConfig,
}

export type GameplayPropeties = GameplayProperties

export type TowerInfo = {
	Id: string,
	Level: number,
}

export type TeamTowers = {
	Left: TowerInfo,
	Main: TowerInfo,
	Right: TowerInfo,
}

export type TeamData = {
	Owner: string,
	Data: {
		Towers: TeamTowers,
		Deck: { string },
	},
}

export type EntityState = {
	One: TeamData,
	Two: TeamData,
}

export type Vec3Data = {
	X: number,
	Y: number,
	Z: number,
}

export type UnitState = {
	NetId: number,
	CardId: string,
	Team: string,
	Position: Vec3Data,
	Health: number,
	MaxHealth: number,
	Moving: boolean?,
}

export type UnitUpdate = {
	NetId: number,
	Position: Vec3Data,
	Health: number,
	Moving: boolean,
}

export type UnitDespawn = {
	NetId: number,
}

export type MatchEnergy = {
	Current: number,
	Max: number,
}

export type Match = {
	MatchId: MatchId,
	Players: { string },
	GameConfig: GameConfig,
	Status: GameStatus,
}

export type MatchMap = {
	[MatchId]: Match,
}

return {}
]]></string>
            </Properties>
          </Item>
        </Item>
