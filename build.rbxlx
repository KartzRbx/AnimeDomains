            return;
        end;
        Rotation = Rotation + speed * dt * 30;
        mainGradient:SetRotation(Rotation, 0.1);
    end);

    return {
        Effects = { mainGradient, strokeGradient, mainStroke },
        Connections = { Connection }
    };
end
