              <Item class="ModuleScript" referent="520">
                <Properties>
                  <string name="Name">UnitsMetaData</string>
                  <string name="Source"><![CDATA[--!strict
-- Funcionamento: factory jecs — cria entity Unit (tropa) com stats + targeting

const ReplicatedStorage = game:GetService("ReplicatedStorage")
const Mega = require(ReplicatedStorage.Shareds.Classes.Mega)
const UnitTag = require(ReplicatedStorage.Shareds.Classes.Tree.Build.Components.Tags.UnitTag)
const ID = require(ReplicatedStorage.Shareds.Classes.Tree.Build.Components.Primitives.ID)
const Level = require(ReplicatedStorage.Shareds.Classes.Tree.Build.Components.Primitives.Level)
const HealthBase = require(ReplicatedStorage.Shareds.Classes.Tree.Build.Components.Primitives.HealthBase)
const Health = require(ReplicatedStorage.Shareds.Classes.Tree.Build.Components.Primitives.Health)
const BaseDamage = require(ReplicatedStorage.Shareds.Classes.Tree.Build.Components.Primitives.BaseDamage)
const Damage = require(ReplicatedStorage.Shareds.Classes.Tree.Build.Components.Primitives.Damage)
const CardImage = require(ReplicatedStorage.Shareds.Classes.Tree.Build.Components.Primitives.CardImage)
const ModelID = require(ReplicatedStorage.Shareds.Classes.Tree.Build.Components.Primitives.ModelID)
const Position = require(ReplicatedStorage.Shareds.Classes.Tree.Build.Components.Primitives.Position)
const Walk = require(ReplicatedStorage.Shareds.Classes.Tree.Build.Components.Primitives.Walk)
const Velocity = require(ReplicatedStorage.Shareds.Classes.Tree.Build.Components.Primitives.Velocity)
const RangeBase = require(ReplicatedStorage.Shareds.Classes.Tree.Build.Components.Primitives.RangeBase)
const Range = require(ReplicatedStorage.Shareds.Classes.Tree.Build.Components.Primitives.Range)
const DelayAttack = require(ReplicatedStorage.Shareds.Classes.Tree.Build.Components.Primitives.DelayAttack)
const EnergyCost = require(ReplicatedStorage.Shareds.Classes.Tree.Build.Components.Primitives.EnergyCost)
const TargetKing = require(ReplicatedStorage.Shareds.Classes.Tree.Build.Components.Primitives.TargetKing)
const Target = require(ReplicatedStorage.Shareds.Classes.Tree.Build.Components.Primitives.Target)
const LastAttack = require(ReplicatedStorage.Shareds.Classes.Tree.Build.Components.Primitives.LastAttack)
const CanRetargetTroops = require(ReplicatedStorage.Shareds.Classes.Tree.Build.Components.Primitives.CanRetargetTroops)
const Class = require(ReplicatedStorage.Shareds.Classes.Tree.Build.Components.Primitives.Class)
const World = Mega.World
const Jecs = Mega.Jecs

export type UnitId = string
export type UnitRange = number
export type UnitDelayAttack = number
export type EnergyCostValue = number
export type TargetKindValue = TargetKing.TargetKindValue

export type UnitConfig = {
	Id: UnitId,
	Level: number,
	BaseHealth: number,
	BaseDamage: number,
	BaseRange: UnitRange,
	DelayAttack: UnitDelayAttack,
	EnergyCost: EnergyCostValue,
	CardImage: string,
	Class: string,
	ModelID: string,
	Position: Vector3,
	Walk: number,
	Velocity: Vector3,
	TargetKind: TargetKindValue,
	CanRetargetTroops: boolean,
}

export type UnitEntity = typeof(World.entity(World))

export type UnitCardParams = {
	Id: UnitId,
	Name: string,
	Level: number,
	Class: string,
	EnergyCost: EnergyCostValue,
	BaseHealth: number,
	BaseDamage: number,
	BaseRange: UnitRange,
	DelayAttack: UnitDelayAttack,
	CardImage: string,
	ModelID: string,
	Walk: number,
	TargetKind: TargetKindValue,
	CanRetargetTroops: boolean,
}

const UnitsFolder = ReplicatedStorage.Shareds.Classes.Tree.Datas.Units
local datasLoaded = false

local function ensureLoaded()
	if datasLoaded then
		return
	end

	datasLoaded = true

	for _, child in UnitsFolder:GetChildren() do
		if child:IsA("ModuleScript") then
			(require :: (ModuleScript) -> any)(child)
		end
	end
end

local function getAll(): { UnitCardParams }
	ensureLoaded()

	local units: { UnitCardParams } = {}

	for entity, id in World:query(UnitTag, ID) do
		if type(id) ~= "string" or id == "" then
			continue
		end

		table.insert(units, {
			Id = id,
			Name = id,
			Level = (World:get(entity, Level) :: number?) or 1,
			Class = (World:get(entity, Class) :: string?) or "",
			EnergyCost = (World:get(entity, EnergyCost) :: number?) or 0,
			BaseHealth = (World:get(entity, HealthBase) :: number?) or 0,
			BaseDamage = (World:get(entity, BaseDamage) :: number?) or 0,
			BaseRange = (World:get(entity, RangeBase) :: number?) or 0,
			DelayAttack = (World:get(entity, DelayAttack) :: number?) or 0,
			CardImage = (World:get(entity, CardImage) :: string?) or "",
			ModelID = (World:get(entity, ModelID) :: string?) or id,
			Walk = (World:get(entity, Walk) :: number?) or 0,
			TargetKind = (World:get(entity, TargetKing) :: TargetKindValue?) or "Ground",
			CanRetargetTroops = World:get(entity, CanRetargetTroops) == true,
		})
	end

	table.sort(units, function(a: UnitCardParams, b: UnitCardParams)
		return a.Id < b.Id
	end)

	return units
end

const function new(config: UnitConfig): UnitEntity
	local entity = World:entity()
	World:set(entity, Jecs.Name, `Unit.{config.Id}`)
	World:add(entity, UnitTag)
	World:set(entity, ID, config.Id)
	World:set(entity, Level, config.Level)
	World:set(entity, HealthBase, config.BaseHealth)
	World:set(entity, Health, config.BaseHealth)
	World:set(entity, BaseDamage, config.BaseDamage)
	World:set(entity, Damage, config.BaseDamage)
	World:set(entity, CardImage, config.CardImage)
	World:set(entity, ModelID, config.ModelID)
	World:set(entity, Position, config.Position)
	World:set(entity, Walk, config.Walk)
	World:set(entity, Class, config.Class)
	World:set(entity, Velocity, config.Velocity)
	World:set(entity, RangeBase, config.BaseRange)
	World:set(entity, Range, config.BaseRange)
	World:set(entity, DelayAttack, config.DelayAttack)
	World:set(entity, EnergyCost, config.EnergyCost)
	World:set(entity, TargetKing, config.TargetKind)
	World:set(entity, Target, 0)
	World:set(entity, LastAttack, 0)
	World:set(entity, CanRetargetTroops, config.CanRetargetTroops)
	return entity
end

local Unit = {
	new = new,
	ensureLoaded = ensureLoaded,
	getAll = getAll,
}

export type Unit = typeof(Unit)

return Unit :: Unit
]]></string>
