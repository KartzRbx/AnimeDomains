              <Item class="ModuleScript" referent="237">
                <Properties>
                  <string name="Name">bool</string>
                  <string name="Source"><![CDATA[local bufferWriter = require(script.Parent.Parent.process.bufferWriter)
local types = require(script.Parent.Parent.types)

local boolean = {
	--[[
		1 = true
		0 = false
		
		Write and read based off a uint8
	]]
	read = function(b: buffer, cursor: number)
		return buffer.readu8(b, cursor) == 1, 1
	end,

	length = 1,

	write = bufferWriter.writebool,
}

return function(): types.dataTypeInterface<boolean>
	return boolean
end
