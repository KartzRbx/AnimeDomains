        <Item class="Folder" referent="422">
          <Properties>
            <string name="Name">tabby0x_simplepath@2.2.6</string>
          </Properties>
          <Item class="ModuleScript" referent="423">
            <Properties>
              <string name="Name">simplepath</string>
              <string name="Source"><![CDATA[--[[
-------------------------------------------------------------------

Originally Created by: @V3N0M_Z
Reference: https://v3n0m-z.github.io/RBLX-SimplePath/
License: MIT

Modified with:
- Full Luau type annotations
- ControllerManager support

---------------------------------------------------------------------
]]

local PathfindingService = game:GetService("PathfindingService")
local RunService = game:GetService("RunService")
local Players = game:GetService("Players")

--[[ TYPES ]]

export type PathSettings = {
	TIME_VARIANCE: number,
	COMPARISON_CHECKS: number,
	JUMP_WHEN_STUCK: boolean,
}

export type PathStatusType = "Idle" | "Active"

export type PathErrorType = "LimitReached" | "TargetUnreachable" | "ComputationError" | "AgentStuck"

export type PathEvents = {
	Reached: BindableEvent,
	WaypointReached: BindableEvent,
	Blocked: BindableEvent,
	Error: BindableEvent,
	Stopped: BindableEvent,
}

export type Path = {
	-- Public Properties
	Visualize: boolean?,
	ControllerManager: ControllerManager?,
	
	-- Readonly Properties (accessed via getter methods)
	Status: PathStatusType,
	LastError: PathErrorType?,
	
	-- Events
	Reached: RBXScriptSignal<Model, PathWaypoint>,
	WaypointReached: RBXScriptSignal<Model, PathWaypoint, PathWaypoint, PathWaypoint>,
	Blocked: RBXScriptSignal<Model, PathWaypoint>,
	Error: RBXScriptSignal<PathErrorType>,
	Stopped: RBXScriptSignal<Model>,
	
	-- Methods
	Run: (self: Path, target: Vector3 | BasePart) -> boolean,
	Stop: (self: Path) -> (),
	Destroy: (self: Path) -> (),
}

type PathInternal = {
	-- Public
	Visualize: boolean?,
	ControllerManager: ControllerManager?,
	
	-- Private
	_settings: PathSettings,
	_events: PathEvents,
	_agent: Model,
	_humanoid: Humanoid?,
	_path: Path,
	_status: PathStatusType,
	_lastError: PathErrorType?,
	_t: number,
	_position: {
		_last: Vector3,
		_count: number,
	},
	_waypoints: { PathWaypoint }?,
	_currentWaypoint: number,
	_target: (Vector3 | BasePart)?,
	_moveConnection: RBXScriptConnection?,
	_controllerMoveConnection: RBXScriptConnection?,
	_visualWaypoints: { Part }?,
}

--[[ CONSTANTS ]]

local DEFAULT_SETTINGS: PathSettings = {
	TIME_VARIANCE = 0.07,
	COMPARISON_CHECKS = 1,
	JUMP_WHEN_STUCK = true,
}

local StatusType = {
	Idle = "Idle" :: "Idle",
	Active = "Active" :: "Active",
}

local ErrorType = {
	LimitReached = "LimitReached" :: "LimitReached",
	TargetUnreachable = "TargetUnreachable" :: "TargetUnreachable",
	ComputationError = "ComputationError" :: "ComputationError",
	AgentStuck = "AgentStuck" :: "AgentStuck",
}

--[[ PRIVATE UTILITIES ]]

local function output(func: (...any) -> (), msg: string)
	func(((func == error and "SimplePath Error: ") or "SimplePath: ") .. msg)
end

--Used to visualize waypoints
local visualWaypointTemplate: Part = Instance.new("Part")
visualWaypointTemplate.Size = Vector3.new(0.3, 0.3, 0.3)
visualWaypointTemplate.Anchored = true
visualWaypointTemplate.CanCollide = false
visualWaypointTemplate.Material = Enum.Material.Neon
visualWaypointTemplate.Shape = Enum.PartType.Ball

local function declareError(self: PathInternal, errorType: PathErrorType)
	self._lastError = errorType
	self._events.Error:Fire(errorType)
end

local function createVisualWaypoints(waypoints: { PathWaypoint }): { Part }
	local visualWaypoints: { Part } = {}
	for _, waypoint in waypoints do
		local visualWaypointClone = visualWaypointTemplate:Clone()
		visualWaypointClone.Position = waypoint.Position
		visualWaypointClone.Parent = workspace
		visualWaypointClone.Color = if waypoint == waypoints[#waypoints]
			then Color3.fromRGB(0, 255, 0)
			elseif waypoint.Action == Enum.PathWaypointAction.Jump then Color3.fromRGB(255, 0, 0)
			else Color3.fromRGB(255, 139, 0)
		table.insert(visualWaypoints, visualWaypointClone)
	end
	return visualWaypoints
end

local function destroyVisualWaypoints(waypoints: { Part }?): nil
	if waypoints then
		for _, waypoint in waypoints do
			waypoint:Destroy()
		end
	end
	return nil
end

local function getNonHumanoidWaypoint(self: PathInternal): number
	local waypoints = self._waypoints
	if not waypoints then
		return 2
	end
	for i = 2, #waypoints do
		if (waypoints[i].Position - waypoints[i - 1].Position).Magnitude > 0.1 then
			return i
		end
	end
	return 2
end

local function setJumpState(self: PathInternal)
	local humanoid = self._humanoid
	if not humanoid then
		return
	end
	pcall(function()
		local state = humanoid:GetState()
		if state ~= Enum.HumanoidStateType.Jumping and state ~= Enum.HumanoidStateType.Freefall then
			humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
		end
	end)
end

local function move(self: PathInternal)
	local waypoints = self._waypoints
	local humanoid = self._humanoid
	if not waypoints or not humanoid then
		return
	end
	
	local currentWaypoint = waypoints[self._currentWaypoint]
	if currentWaypoint.Action == Enum.PathWaypointAction.Jump then
		setJumpState(self)
	end
	humanoid:MoveTo(currentWaypoint.Position)
end

local function disconnectMoveConnection(self: PathInternal)
	if self._moveConnection then
		self._moveConnection:Disconnect()
		self._moveConnection = nil
	end
end

local function disconnectControllerMoveConnection(self: PathInternal)
	if self._controllerMoveConnection then
		self._controllerMoveConnection:Disconnect()
		self._controllerMoveConnection = nil
	end
end

local function invokeWaypointReached(self: PathInternal)
	local waypoints = self._waypoints
	if not waypoints then
		return
	end
	local lastWaypoint = waypoints[self._currentWaypoint - 1]
	local currentWaypoint = waypoints[self._currentWaypoint]
	local nextWaypoint = waypoints[math.min(self._currentWaypoint + 1, #waypoints)] -- prevent out of bounds
	self._events.WaypointReached:Fire(self._agent, lastWaypoint, currentWaypoint, nextWaypoint)
end

local function comparePosition(self: PathInternal)
	local waypoints = self._waypoints
	if not waypoints then
		return
	end
	
	if self._currentWaypoint == #waypoints then
		return
	end
	
	local primaryPart = self._agent.PrimaryPart
	if not primaryPart then
		return
	end
	
	local magnitude = (primaryPart.Position - self._position._last).Magnitude
	self._position._count = if magnitude <= 0.07 then self._position._count + 1 else 0
	self._position._last = primaryPart.Position
	
	if self._position._count >= self._settings.COMPARISON_CHECKS then
		if self._settings.JUMP_WHEN_STUCK then
			setJumpState(self)
		end
		declareError(self, ErrorType.AgentStuck)
	end
end

-- Forward declaration for mutual recursion
local moveToFinished: (self: PathInternal, reached: boolean) -> ()

moveToFinished = function(self: PathInternal, reached: boolean)
	local waypoints = self._waypoints
	if not waypoints then
		return
	end
	
	-- Handle case for non-humanoids
	if not self._humanoid then
		if reached and self._currentWaypoint + 1 <= #waypoints then
			invokeWaypointReached(self)
			self._currentWaypoint += 1
		elseif reached then
			if self.ControllerManager then
				self.ControllerManager.MovingDirection = Vector3.zero
			end
			self._visualWaypoints = destroyVisualWaypoints(self._visualWaypoints)
			self._target = nil
			self._events.Reached:Fire(self._agent, waypoints[self._currentWaypoint])
		else
			self._visualWaypoints = destroyVisualWaypoints(self._visualWaypoints)
			self._target = nil
			declareError(self, ErrorType.TargetUnreachable)
		end
		return
	end

	if reached and self._currentWaypoint + 1 <= #waypoints then
		-- Waypoint reached
		if self._currentWaypoint + 1 < #waypoints then
			invokeWaypointReached(self)
		end
		self._currentWaypoint += 1
		move(self)
	elseif reached then
		-- Target reached, pathfinding ends
		if self.ControllerManager then
			self.ControllerManager.MovingDirection = Vector3.zero
		end
		disconnectMoveConnection(self)
		self._status = StatusType.Idle
		self._visualWaypoints = destroyVisualWaypoints(self._visualWaypoints)
		self._events.Reached:Fire(self._agent, waypoints[self._currentWaypoint])
	else
		-- Target unreachable
		disconnectMoveConnection(self)
		self._status = StatusType.Idle
		self._visualWaypoints = destroyVisualWaypoints(self._visualWaypoints)
		declareError(self, ErrorType.TargetUnreachable)
	end
end

--[[ PATH CLASS ]]

local Path = {}
Path.StatusType = StatusType
Path.ErrorType = ErrorType

--[[ STATIC METHODS ]]

function Path.GetNearestCharacter(fromPosition: Vector3): Model?
	local character: Model? = nil
	local dist = math.huge
	
	for _, player in Players:GetPlayers() do
		local playerCharacter = player.Character
		if playerCharacter then
			local primaryPart = playerCharacter.PrimaryPart
			if primaryPart then
				local magnitude = (primaryPart.Position - fromPosition).Magnitude
				if magnitude < dist then
					character = playerCharacter
					dist = magnitude
				end
			end
		end
	end
	
	return character
end

--[[ CONSTRUCTOR ]]

function Path.new(agent: Model, agentParameters: { [string]: any }?, override: PathSettings?): Path
	if not (agent and agent:IsA("Model") and agent.PrimaryPart) then
		output(error, "Pathfinding agent must be a valid Model Instance with a set PrimaryPart.")
	end

	local settings: PathSettings = override or table.clone(DEFAULT_SETTINGS)
	
	-- Configure settings with defaults
	for setting, value in DEFAULT_SETTINGS do
		if settings[setting] == nil then
			settings[setting] = value
		end
	end

	local events: PathEvents = {
		Reached = Instance.new("BindableEvent"),
		WaypointReached = Instance.new("BindableEvent"),
		Blocked = Instance.new("BindableEvent"),
		Error = Instance.new("BindableEvent"),
		Stopped = Instance.new("BindableEvent"),
	}
	
	-- Find humanoid (only if EvaluateStateMachine is enabled)
	local humanoid = agent:FindFirstChildOfClass("Humanoid")
	if humanoid and not humanoid.EvaluateStateMachine then
		humanoid = nil
	end
	
	-- Find ControllerManager
	local controllerManager = agent:FindFirstChildOfClass("ControllerManager")

	local pathInstance = PathfindingService:CreatePath(agentParameters)
	
	local self: PathInternal = {
		-- Public
		Visualize = nil,
		ControllerManager = controllerManager,
		
		-- Private
		_settings = settings,
		_events = events,
		_agent = agent,
		_humanoid = humanoid,
		_path = pathInstance :: any,
		_status = StatusType.Idle,
		_lastError = nil,
		_t = 0,
		_position = {
			_last = Vector3.new(),
			_count = 0,
		},
		_waypoints = nil,
		_currentWaypoint = 2,
		_target = nil,
		_moveConnection = nil,
		_controllerMoveConnection = nil,
		_visualWaypoints = nil,
	}

	-- Path blocked connection
	pathInstance.Blocked:Connect(function(blockedWaypointIndex: number)
		if self._waypoints and self._humanoid then
			if self._currentWaypoint <= blockedWaypointIndex and self._currentWaypoint + 1 >= blockedWaypointIndex then
				setJumpState(self)
				self._events.Blocked:Fire(self._agent, self._waypoints[blockedWaypointIndex])
			end
		end
	end)

	-- Methods defined as local functions that will be added to proxy
	local function Destroy()
		for _, event in events do
			event:Destroy()
		end
		
		disconnectMoveConnection(self)
		disconnectControllerMoveConnection(self)
		
		if self._visualWaypoints then
			self._visualWaypoints = destroyVisualWaypoints(self._visualWaypoints)
		end
		
		pathInstance:Destroy()
	end

	local function Stop()
		if not self._humanoid then
			output(error, "Attempt to call Path:Stop() on a non-humanoid.")
			return
		end
		
		if self._status == StatusType.Idle then
			output(function(m)
				warn(debug.traceback(m))
			end, "Attempt to run Path:Stop() in idle state")
			return
		end
		
		disconnectMoveConnection(self)
		disconnectControllerMoveConnection(self)
		self._status = StatusType.Idle
		self._visualWaypoints = destroyVisualWaypoints(self._visualWaypoints)
		events.Stopped:Fire(self._agent)
	end

	local function Run(_: any, target: Vector3 | BasePart): boolean
		-- Non-humanoid handle case
		if not target and not self._humanoid and self._target then
			moveToFinished(self, true)
			return true
		end

		-- Parameter check
		if not (target and (typeof(target) == "Vector3" or (typeof(target) == "Instance" and target:IsA("BasePart")))) then
			output(error, "Pathfinding target must be a valid Vector3 or BasePart.")
			return false
		end

		-- Re-check humanoid reference in case EvaluateStateMachine changed for performance
        if not self._humanoid then
            local humanoid = self._agent:FindFirstChildOfClass("Humanoid")
            if humanoid and humanoid.EvaluateStateMachine then
                self._humanoid = humanoid
            end
        end

		-- Refer to Settings.TIME_VARIANCE
		if os.clock() - self._t <= self._settings.TIME_VARIANCE and self._humanoid then
			task.wait(os.clock() - self._t)
			declareError(self, ErrorType.LimitReached)
			return false
		elseif self._humanoid then
			self._t = os.clock()
		end

		-- Get target position
		local targetPosition: Vector3 = if typeof(target) == "Vector3" 
			then target 
			else (target :: BasePart).Position

		-- Compute path
		local primaryPart = self._agent.PrimaryPart
		if not primaryPart then
			declareError(self, ErrorType.ComputationError)
			return false
		end

		local pathComputed = pcall(function()
			pathInstance:ComputeAsync(self._agent:GetPivot().Position, targetPosition)
		end)

		-- Make sure path computation is successful
		local humanoidFalling = self._humanoid and self._humanoid:GetState() == Enum.HumanoidStateType.Freefall
		
		if not pathComputed 
			or pathInstance.Status == Enum.PathStatus.NoPath 
			or #pathInstance:GetWaypoints() < 2 
			or humanoidFalling 
		then
			self._visualWaypoints = destroyVisualWaypoints(self._visualWaypoints)
			task.wait()
			declareError(self, ErrorType.ComputationError)
			return false
		end

		-- Set status to active; pathfinding starts
		self._status = if self._humanoid or self.ControllerManager 
			then StatusType.Active 
			else StatusType.Idle
		self._target = target

		-- Set network owner to server to prevent "hops"
		pcall(function()
			primaryPart:SetNetworkOwner(nil)
		end)

		-- Initialize waypoints
		self._waypoints = pathInstance:GetWaypoints()
		self._currentWaypoint = 2

		-- Refer to Settings.COMPARISON_CHECKS
		if self._humanoid then
			comparePosition(self)
		end

		-- Visualize waypoints
		destroyVisualWaypoints(self._visualWaypoints)
		self._visualWaypoints = if self.Visualize then createVisualWaypoints(self._waypoints) else nil

		local nextWaypointPos = self._waypoints[self._currentWaypoint].Position

		if self._humanoid then
			-- Use the classic MoveTo method and connection
			if not self._moveConnection then
				self._moveConnection = self._humanoid.MoveToFinished:Connect(function(reached: boolean)
					moveToFinished(self, reached)
				end)
			end
			self._humanoid:MoveTo(nextWaypointPos)
			
		elseif self.ControllerManager then
			local controllerManager = self.ControllerManager
			local threshold = 1 -- Distance threshold (studs) to consider the waypoint reached
			
			disconnectControllerMoveConnection(self)
			
			self._controllerMoveConnection = RunService.Stepped:Connect(function()
				local agentPos = primaryPart.Position
				local direction = (
					Vector3.new(nextWaypointPos.X, 0, nextWaypointPos.Z) 
					- Vector3.new(agentPos.X, 0, agentPos.Z)
				).Unit
				
				controllerManager.MovingDirection = direction
				controllerManager.FacingDirection = direction

				local currentAgentPosFlat = Vector3.new(agentPos.X, 0, agentPos.Z)
				local waypointPosFlat = Vector3.new(nextWaypointPos.X, 0, nextWaypointPos.Z)

				if (currentAgentPosFlat - waypointPosFlat).Magnitude < threshold then
					disconnectControllerMoveConnection(self)
					moveToFinished(self, true)
				end
			end)
		else
			-- Non-humanoid and no ControllerManager fallback

			warn("SimplePath: Non-humanoid agent without ControllerManager cannot pathfind properly.")

			self._currentWaypoint = getNonHumanoidWaypoint(self)
			moveToFinished(self, true)
		end
		
		return true
	end

	-- Create the proxy object with proper __index for events and methods
	local proxy = setmetatable({
		-- Methods are directly on the table
		Destroy = Destroy,
		Stop = Stop,
		Run = Run,
	}, {
		__index = function(_, key: string)
			-- Events
			if key == "Reached" then return events.Reached.Event end
			if key == "WaypointReached" then return events.WaypointReached.Event end
			if key == "Blocked" then return events.Blocked.Event end
			if key == "Error" then return events.Error.Event end
			if key == "Stopped" then
				if not self._humanoid then
					output(error, "Attempt to use Path.Stopped on a non-humanoid.")
				end
				return events.Stopped.Event
			end
			
			-- Readonly properties
			if key == "LastError" then return self._lastError end
			if key == "Status" then return self._status end
			
			-- Public properties
			if key == "Visualize" then return self.Visualize end
			if key == "ControllerManager" then return self.ControllerManager end
			
			-- Static references
			if key == "StatusType" then return StatusType end
			if key == "ErrorType" then return ErrorType end
			
			return nil
		end,
		
		__newindex = function(_, key: string, value: any)
			if key == "Visualize" then
				self.Visualize = value
			elseif key == "ControllerManager" then
				self.ControllerManager = value
			end
		end,
	})

	return proxy :: any
end

return Path
]]></string>
