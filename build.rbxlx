                <Item class="ModuleScript" referent="133">
                  <Properties>
                    <string name="Name">shadow</string>
                    <string name="Source">local vide = require(script.Parent.Parent.Parent.Parent.vide)

local create = vide.create

type can&lt;T> = T | () -> T
type props = {
	zindex: can&lt;number>?,
