        <Item class="Script" referent="578">
          <Properties>
            <string name="Name">Jabby</string>
            <token name="RunContext">0</token>
            <string name="Source"><![CDATA[--!strict

const ReplicatedStorage = game:GetService("ReplicatedStorage")

local JabbyRemoteTypes = {
	server_registered = false,
	ping = false,
	client_registered = false,
	update_server_data = false,
	send_mouse_pointer = false,
	send_mouse_entity = true,
	validate_query = false,
	validate_result = false,
	replicate_query = false,
	disconnect_query = false,
	advance_query_page = false,
	pause_query = false,
	refresh_query = false,
	update_query_result = true,
	count_total_entities = true,
	initiate_replicate_scheduler = false,
	disconnect_replicate_scheduler = false,
	scheduler_system_update_static = false,
	append_frame_system = true,
	scheduler_pause = false,
	validate_entity_component = false,
	validate_entity_component_result = false,
	inspect_entity = false,
	get_entity_component = false,
	return_entity_component = false,
	delete_entity = false,
	stop_inspect_entity = false,
	update_entity = false,
	inspect_entity_settings_update = false,
	inspect_entity_update = false,
	create_watch = false,
	remove_watch = false,
	request_watch_data = false,
	update_watch_data = false,
	start_record_watch = false,
	stop_watch = false,
	clear_watch = false,
	connect_to_watch = false,
	disconnect_watch = false,
	update_watch_overview = true,
}

local function EnsureJabbyRemote(name: string, unreliable: boolean)
	local folder = ReplicatedStorage:FindFirstChild("JABBY_REMOTES")
	if not folder then
		folder = Instance.new("Folder")
		folder.Name = "JABBY_REMOTES"
		folder.Archivable = true
		folder.Parent = ReplicatedStorage
	end

	local remote = folder:FindFirstChild(name)
	if not remote then
		remote = Instance.new(if unreliable then "UnreliableRemoteEvent" else "RemoteEvent")
		remote.Name = name
		remote.Parent = folder
	end

	if not remote:FindFirstChild("actor") then
		local actor = Instance.new("BindableEvent")
		actor.Name = "actor"
		actor.Parent = remote
	end

	if not remote:FindFirstChild("peer") then
		local peer = Instance.new("RemoteEvent")
		peer.Name = "peer"
		peer.Parent = remote
	end
end

for name, unreliable in JabbyRemoteTypes do
	EnsureJabbyRemote(name, unreliable)
end

const Jabby = require(ReplicatedStorage.Packages.jabby)
const Mega = require(ReplicatedStorage.Shareds.Classes.Mega)

const World = Mega.World
const Jecs = Mega.Jecs

local ComponentsRoot = ReplicatedStorage.Shareds.Classes.Tree.Build.Components
local DatasRoot = ReplicatedStorage.Shareds.Classes.Tree.Datas

local function NameEntity(entity: any, name: string)
	if World:get(entity, Jecs.Name) ~= name then
		World:set(entity, Jecs.Name, name)
	end
end

local function NameComponentsInFolder(folder: Folder, prefix: string)
	for _, child in folder:GetChildren() do
		if not child:IsA("ModuleScript") then
			continue
		end

		local ok, entity = pcall(require, child)
		if ok then
			NameEntity(entity, `{prefix}.{child.Name}`)
		else
			warn(`[JabbyBoot] Failed to require component: {child:GetFullName()} | {entity}`)
		end
	end
end

local function RegisterComponentNames()
	local primitives = ComponentsRoot:FindFirstChild("Primitives")
	if primitives and primitives:IsA("Folder") then
		NameComponentsInFolder(primitives, "Primitive")
	end

	local tags = ComponentsRoot:FindFirstChild("Tags")
	if tags and tags:IsA("Folder") then
		NameComponentsInFolder(tags, "Tag")
	end
end

local function RequireModulesInFolder(folder: Folder)
	for _, child in folder:GetChildren() do
		if child:IsA("Folder") then
			RequireModulesInFolder(child)
			continue
		end

		if not child:IsA("ModuleScript") then
			continue
		end

		local ok, result = pcall(require, child)
		if ok then
			print(`[JabbyBoot] Loaded JECS data: {child:GetFullName()} -> {result}`)
		else
			warn(`[JabbyBoot] Failed to load JECS data: {child:GetFullName()} | {result}`)
		end
	end
end

local function RegisterDataEntities()
	local towers = DatasRoot:FindFirstChild("Towers")
	if towers and towers:IsA("Folder") then
		RequireModulesInFolder(towers)
	end

	local units = DatasRoot:FindFirstChild("Units")
	if units and units:IsA("Folder") then
		RequireModulesInFolder(units)
	end
end

Jabby.set_check_function(function(_player: Player)
	return true
end)

RegisterComponentNames()
RegisterDataEntities()

Jabby.register({
	name = "Anime Domains World",
	applet = Jabby.applets.world,
	configuration = {
		world = World,
	},
})

print("[JabbyBoot] AnimeDomains JECS world registered")
]]></string>
