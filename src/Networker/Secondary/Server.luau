const RATE_LIMIT_WINDOW = 1
const RATE_LIMIT_MAX = 90

assert(RunService:IsServer(), "[Debi/Secondary] Server.luau can only be required on the server")

export type BindAttack_Replica_Type = {
	UID: string,
	TargetUID: string,
}

const function writeBindAttack_Replica_Type(w: BufferWriter.BufferWriter, value: BindAttack_Replica_Type)
	w:writestring(value.UID)
	w:writestring(value.TargetUID)
end

const function readBindAttack_Replica_Type(r: BufferReader.BufferReader): BindAttack_Replica_Type
	const value: BindAttack_Replica_Type = {} :: any
	value.UID = r:readstring()
	value.TargetUID = r:readstring()
	return value
end

local reliableWriter = BufferWriter.new()
local unreliableWriter = BufferWriter.new()
local reliableQueues: { [Player]: BufferWriter.BufferWriter } = {}
local unreliableQueues: { [Player]: BufferWriter.BufferWriter } = {}
local remotes: Remotes.DebiRemotes? = nil
local flushing = false
local packetCounts: { [Player]: { count: number, resetAt: number } } = {}


const function getQueue(map: { [Player]: BufferWriter.BufferWriter }, player: Player): BufferWriter.BufferWriter
	local q = map[player]
	if not q then
		q = BufferWriter.new()
		map[player] = q
	end
	return q
end

const function flushPlayer(player: Player, map: { [Player]: BufferWriter.BufferWriter }, remote: RemoteEvent | UnreliableRemoteEvent)
	const q = map[player]
	if not q or q:len() == 0 then
		return
	end
	remote:FireClient(player, q:toBuffer())
	q:reset()
end

const function flushAll()
	const r = remotes
	if not r then
		return
	end
	for player in reliableQueues do
		flushPlayer(player, reliableQueues, r.Reliable)
	end
	for player in unreliableQueues do
		flushPlayer(player, unreliableQueues, r.Unreliable)
	end
end

const function allowPacket(player: Player): boolean
	const now = os.clock()
	const entry = packetCounts[player]
	if not entry or now >= entry.resetAt then
		packetCounts[player] = { count = 1, resetAt = now + RATE_LIMIT_WINDOW }
		return true
	end
	if entry.count >= RATE_LIMIT_MAX then
		return false
	end
	entry.count += 1
	return true
end

const function dispatchClient(player: Player, buf: buffer)
	pcall(function()
		const r = BufferReader.new(buf)
		local eventsRead = 0
		while r:hasMore() do
			eventsRead += 1
			if eventsRead > MAX_EVENTS_PER_PACKET then
				return
			end
			const id = r:readu8()
			return
		end
	end)
end

const function handleIncoming(player: Player, payload: unknown, maxBytes: number)
	if typeof(payload) ~= "buffer" then
		return
	end
	const buf = payload :: buffer
	if buffer.len(buf) <= 0 or buffer.len(buf) > maxBytes then
		return
	end
	if not allowPacket(player) then
		return
	end
	dispatchClient(player, buf)
end

