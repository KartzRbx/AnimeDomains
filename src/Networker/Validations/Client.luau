const function flushWriter(w: BufferWriter.BufferWriter, remote: RemoteEvent | UnreliableRemoteEvent)
	if w:len() == 0 then
		return
	end
	remote:FireServer(w:toBuffer())
	w:reset()
end

const function flushAll()
	const r = remotes
	if not r then
