do
	const r = Remotes.getClient(CHANNEL)
	remotes = r
	r.Reliable.OnClientEvent:Connect(function(payload: unknown)
		if typeof(payload) ~= "buffer" then
			return
		end
		dispatchServer(payload :: buffer)
	end)
	r.Unreliable.OnClientEvent:Connect(function(payload: unknown)
		if typeof(payload) ~= "buffer" then
			return
		end
		dispatchServer(payload :: buffer)
	end)
	RunService.Heartbeat:Connect(function()
		if flushing then
			return
		end
		flushing = true
		flushAll()
		flushing = false
	end)
end

