export type Vec3Data = {
	X: number,
	Y: number,
	Z: number,
}

const function writeVec3Data(w: BufferWriter.BufferWriter, value: Vec3Data)
	w:writef32(value.X)
	w:writef32(value.Y)
	w:writef32(value.Z)
end

const function readVec3Data(r: BufferReader.BufferReader): Vec3Data
	const value: Vec3Data = {} :: any
	value.X = r:readf32()
	value.Y = r:readf32()
	value.Z = r:readf32()
	return value
end

