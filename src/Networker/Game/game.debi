-----------------------------------------
--- << GAME CHANNEL >> ---
-----------------------------------------

opt channel = "Game"
opt server_output = "src/Networker/Game/Server.luau"
opt client_output = "src/Networker/Game/Client.luau"

-----------------------------------------
--- << TYPES / CORE >> ---
-----------------------------------------

type Vec3Data = struct {
	X: f32,
	Y: f32,
	Z: f32,
}

-----------------------------------------
--- << TYPES / MATCH >> ---
-----------------------------------------

type TowerInfo = struct {
	Id: string,
	Level: u16,
}

type TeamTowers = struct {
	Left: TowerInfo,
	Main: TowerInfo,
	Right: TowerInfo,
}

type TeamInner = struct {
	Towers: TeamTowers,
	Deck: string[],
}

type TeamData = struct {
	Owner: string,
	Data: TeamInner,
}

type EntityState = struct {
	One: TeamData,
	Two: TeamData,
}

type MatchEnergy = struct {
	Current: f32,
	Max: f32,
}

-----------------------------------------
--- << TYPES / CARDS >> ---
-----------------------------------------

type PlaceUnitRequest = struct {
	CardId: string,
	SlotIndex: u8,
	Position: Vec3Data,
}

type CardHandState = struct {
	Hand: string[],
	NextCard: string,
}


type SpawnEntityInMapFromServerType = struct {
	CardId: string,
	Ready: bool,
	Attacking: bool,
	Player: Player,
	Position: Vec3Data,
}

type CardID = string

-----------------------------------------
--- << TYPES / UNITS >> ---
-----------------------------------------

type UnitState = struct {
	NetId: u32,
	CardId: string,
	Team: string,
	Position: Vec3Data,
	Health: f32,
	MaxHealth: f32,
	Moving: bool,
}

type UnitUpdate = struct {
	NetId: u32,
	Position: Vec3Data,
	Health: f32,
	Moving: bool,
}

-----------------------------------------
--- << EVENTS / ENERGY >> ---
-----------------------------------------

event FetchPlayerEnergy = {
	from: Server,
	type: Unreliable,
	call: SingleAsync,
	data: (energy: f32),
}

event SetEnergy = {
	from: Server,
	type: Unreliable,
	call: SingleAsync,
	data: (energy: MatchEnergy),
}

-----------------------------------------
--- << EVENTS / CARDS >> ---
-----------------------------------------

event PutCardInPlace = {
	from: Client,
	type: Reliable,
	call: SingleAsync,
	data: (payload: PlaceUnitRequest),
}

event SyncCardHand = {
	from: Server,
	type: Reliable,
	call: SingleAsync,
	data: (state: CardHandState),
}

event SpawnEntityInMapFromServer = {
	from: Server,
	type: Reliable,
	call: SingleAsync,
	data: (payload: SpawnEntityInMapFromServerType),
}
-----------------------------------------
--- << EVENTS / MATCH >> ---
-----------------------------------------

event SetEntityState = {
	from: Server,
	type: Reliable,
	call: SingleAsync,
	data: (state: EntityState),
}

-----------------------------------------
--- << EVENTS / UNITS >> ---
-----------------------------------------

event AddUnit = {
	from: Server,
	type: Reliable,
	call: ManyAsync,
	data: (unit: UnitState),
}

event UpdateUnit = {
	from: Server,
	type: Unreliable,
	call: ManyAsync,
	data: (unit: UnitUpdate),
}

event RemoveUnit = {
	from: Server,
	type: Reliable,
	call: ManyAsync,
	data: (netId: u32),
}
