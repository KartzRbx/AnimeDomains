do
	const r = Remotes.getServer(CHANNEL)
	remotes = r
	Players.PlayerRemoving:Connect(function(player: Player)
		packetCounts[player] = nil
		reliableQueues[player] = nil
		unreliableQueues[player] = nil
	end)
	r.Reliable.OnServerEvent:Connect(function(player: Player, payload: unknown)
		handleIncoming(player, payload, MAX_RELIABLE_BYTES)
	end)
	r.Unreliable.OnServerEvent:Connect(function(player: Player, payload: unknown)
		handleIncoming(player, payload, MAX_UNRELIABLE_BYTES)
	end)
	RunService.Heartbeat:Connect(function()
		if flushing then
			return
		end
		flushing = true
		flushAll()
		flushing = false
	end)
end

return Debi
